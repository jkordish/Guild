      "skill": "skill://example/render-report@^0.1",
      "args": {
        "title": "Daily execution summary",
        "sections": [
          {
            "heading": "Inputs",
            "body": "Summarize the planned input bundle."
          }
        ]
      },
      "dependsOn": [],
      "requestedGrants": [],
      "expectedOutputs": [
        {
          "name": "draftMarkdown",
          "kind": "text"
        }
      ],
      "expectedEvidence": [],
