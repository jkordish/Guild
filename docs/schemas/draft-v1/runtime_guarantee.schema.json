{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild Runtime Guarantee",
  "type": "object",
  "properties": {
    "kind": {
      "const": "guild.runtime_guarantee"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "runtime_guarantee_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "component_model_support": {
      "type": "object",
      "properties": {
        "component_model": {
          "type": "string",
          "enum": [
            "wasm-component"
          ]
        },
        "supported_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wit_worlds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "component_model",
        "supported_versions",
        "wit_worlds"
      ],
      "additionalProperties": false
    },
    "execution_isolation_assurance": {
      "$ref": "common.schema.json#/$defs/execution_isolation_assurance"
    },
    "filesystem_isolation_class": {
      "$ref": "common.schema.json#/$defs/filesystem_isolation_class"
    },
    "network_policy_granularity": {
      "$ref": "common.schema.json#/$defs/network_policy_granularity"
    },
    "child_process_policy": {
      "type": "object",
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/child_process_mode"
          },
          "uniqueItems": true
        },
        "default_mode": {
          "$ref": "common.schema.json#/$defs/child_process_mode"
        }
      },
      "required": [
        "supported_modes",
        "default_mode"
      ],
      "additionalProperties": false
    },
    "token_passthrough_policy": {
      "type": "object",
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/token_passthrough_mode"
          },
          "uniqueItems": true
        },
        "default_mode": {
          "$ref": "common.schema.json#/$defs/token_passthrough_mode"
        }
      },
      "required": [
        "supported_modes",
        "default_mode"
      ],
      "additionalProperties": false
    },
    "revocation_behavior": {
      "type": "object",
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/revocation_mode"
          },
          "uniqueItems": true
        },
        "default_mode": {
          "$ref": "common.schema.json#/$defs/revocation_mode"
        }
      },
      "required": [
        "supported_modes",
        "default_mode"
      ],
      "additionalProperties": false
    },
    "delegation_enforcement": {
      "type": "object",
      "properties": {
        "audience_binding": {
          "type": "boolean"
        },
        "call_chain_binding": {
          "type": "boolean"
        },
        "anti_replay": {
          "type": "boolean"
        },
        "max_hops_enforced": {
          "type": "boolean"
        }
      },
      "required": [
        "audience_binding",
        "call_chain_binding",
        "anti_replay",
        "max_hops_enforced"
      ],
      "additionalProperties": false
    },
    "witness_support": {
      "$ref": "common.schema.json#/$defs/witness_support"
    },
    "supported_effect_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/effect_class"
      },
      "uniqueItems": true
    },
    "supported_canonical_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/canonical_effect_family"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "version",
    "runtime_guarantee_id",
    "runtime",
    "component_model_support",
    "execution_isolation_assurance",
    "filesystem_isolation_class",
    "network_policy_granularity",
    "child_process_policy",
    "token_passthrough_policy",
    "revocation_behavior",
    "delegation_enforcement",
    "witness_support",
    "supported_effect_classes",
    "supported_canonical_families"
  ],
  "additionalProperties": false
}
