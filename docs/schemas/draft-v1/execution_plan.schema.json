{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild Execution Plan",
  "type": "object",
  "properties": {
    "kind": {
      "const": "guild.execution_plan"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "plan_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "contract_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "contract_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "component_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "export_name": {
      "type": "string",
      "minLength": 1
    },
    "input_class_fingerprint": {
      "$ref": "common.schema.json#/$defs/input_class_fingerprint"
    },
    "decision": {
      "$ref": "common.schema.json#/$defs/admission_decision"
    },
    "decision_reason_codes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/admission_reason_code"
      },
      "uniqueItems": true,
      "default": []
    },
    "preferred_runtime_guarantee_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "chosen_runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "runtime_guarantee_id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "runtime_guarantee_digest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "runtime": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "vendor": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "runtime_guarantee_id",
            "runtime_guarantee_digest",
            "runtime"
          ],
          "additionalProperties": false
        }
      ]
    },
    "runtime_evaluations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "runtime_guarantee_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "runtime": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "vendor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              }
            ]
          },
          "preferred": {
            "type": "boolean"
          },
          "chosen": {
            "type": "boolean"
          },
          "hard_requirements_satisfied": {
            "type": "boolean"
          },
          "admissible": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/admission_reason_code"
            },
            "uniqueItems": true,
            "default": []
          },
          "unsatisfied_requirements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unsatisfied_requirement"
            },
            "default": []
          }
        },
        "required": [
          "runtime_guarantee_id",
          "runtime",
          "preferred",
          "chosen",
          "hard_requirements_satisfied",
          "admissible",
          "reason_codes",
          "unsatisfied_requirements"
        ],
        "additionalProperties": false
      }
    },
    "requested_authority": {
      "$ref": "common.schema.json#/$defs/authority_plan"
    },
    "granted_authority": {
      "$ref": "common.schema.json#/$defs/authority_plan"
    },
    "denied_authority": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/denied_scope"
      },
      "default": []
    },
    "hard_requirement_status": {
      "type": "object",
      "properties": {
        "satisfied": {
          "type": "boolean"
        },
        "unsatisfied_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unsatisfied_requirement"
          },
          "default": []
        }
      },
      "required": [
        "satisfied",
        "unsatisfied_requirements"
      ],
      "additionalProperties": false
    },
    "request_narrowing_applied": {
      "type": "boolean"
    },
    "proof_prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      },
      "default": []
    },
    "witness_policy": {
      "type": "object",
      "properties": {
        "contract_witness_level": {
          "$ref": "common.schema.json#/$defs/witness_level"
        },
        "requested_witness_level": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/witness_level"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_witness_level": {
          "$ref": "common.schema.json#/$defs/witness_level"
        },
        "supported_levels": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/witness_level"
          },
          "uniqueItems": true,
          "default": []
        },
        "acceptable_tamper_evidence_modes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/tamper_evidence_mode"
          },
          "uniqueItems": true
        },
        "acceptable_signature_modes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/signature_mode"
          },
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          },
          "default": []
        }
      },
      "required": [
        "contract_witness_level",
        "requested_witness_level",
        "effective_witness_level",
        "supported_levels",
        "acceptable_tamper_evidence_modes",
        "acceptable_signature_modes",
        "prerequisites"
      ],
      "additionalProperties": false
    },
    "delegation_token_policy_inputs": {
      "type": "object",
      "properties": {
        "contract_delegation_policy": {
          "$ref": "common.schema.json#/$defs/delegation_policy"
        },
        "required_token_passthrough_mode": {
          "$ref": "common.schema.json#/$defs/token_passthrough_mode"
        },
        "runtime_default_token_passthrough_mode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/token_passthrough_mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_revocation_mode": {
          "$ref": "common.schema.json#/$defs/revocation_mode"
        },
        "runtime_default_revocation_mode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/revocation_mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience_binding_required": {
          "type": "boolean"
        },
        "call_chain_binding_required": {
          "type": "boolean"
        },
        "anti_replay_required": {
          "type": "boolean"
        },
        "max_hops_enforced_required": {
          "type": "boolean"
        },
        "audience_binding_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "resource_binding_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "effect_class": {
                "$ref": "common.schema.json#/$defs/effect_class"
              },
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "effect_class",
              "resource",
              "audience"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "delegation_chain_input": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "caller_chain": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "common.schema.json#/$defs/identifier"
                  }
                },
                "requested_max_hops": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                }
              },
              "required": [
                "caller_chain",
                "requested_max_hops"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "contract_delegation_policy",
        "required_token_passthrough_mode",
        "runtime_default_token_passthrough_mode",
        "required_revocation_mode",
        "runtime_default_revocation_mode",
        "audience_binding_required",
        "call_chain_binding_required",
        "anti_replay_required",
        "max_hops_enforced_required",
        "audience_binding_inputs",
        "resource_binding_inputs",
        "delegation_chain_input"
      ],
      "additionalProperties": false
    },
    "plan_validity": {
      "type": "object",
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "contract_ttl_seconds_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "requested_ttl_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "contract",
            "contract_and_request"
          ]
        },
        "not_before": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "not_after": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "ttl_seconds",
        "contract_ttl_seconds_max",
        "requested_ttl_seconds",
        "source"
      ],
      "additionalProperties": false
    },
    "plan_signature": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/plan_signature"
        }
      ]
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "version",
    "plan_id",
    "request_id",
    "contract_id",
    "contract_digest",
    "component_digest",
    "export_name",
    "input_class_fingerprint",
    "decision",
    "decision_reason_codes",
    "preferred_runtime_guarantee_id",
    "chosen_runtime",
    "runtime_evaluations",
    "requested_authority",
    "granted_authority",
    "denied_authority",
    "hard_requirement_status",
    "request_narrowing_applied",
    "proof_prerequisites",
    "witness_policy",
    "delegation_token_policy_inputs",
    "plan_validity"
  ],
  "additionalProperties": false,
  "$defs": {
    "reason_item": {
      "type": "object",
      "properties": {
        "reason_code": {
          "$ref": "common.schema.json#/$defs/admission_reason_code"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "object"
        }
      },
      "required": [
        "reason_code",
        "message",
        "detail"
      ],
      "additionalProperties": false
    },
    "unsatisfied_requirement": {
      "type": "object",
      "properties": {
        "requirement_kind": {
          "type": "string",
          "enum": [
            "component_model_support",
            "component_model_version",
            "wit_world",
            "effect_class",
            "required_effect_scope",
            "runtime_guarantee",
            "delegation_enforcement",
            "witness_support",
            "requested_witness_level",
            "required_effect",
            "runtime_candidate",
            "runtime_schema",
            "contract_reference",
            "export_name",
            "input_class_fingerprint"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "$ref": "#/$defs/reason_item"
        }
      },
      "required": [
        "requirement_kind",
        "subject",
        "reason"
      ],
      "additionalProperties": false
    },
    "denied_scope": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "contract_ceiling",
            "runtime_enforcement"
          ]
        },
        "requested_effect": {
          "$ref": "common.schema.json#/$defs/effect_spec"
        },
        "granted_effects": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/effect_spec"
          },
          "default": []
        },
        "reason": {
          "$ref": "#/$defs/reason_item"
        }
      },
      "required": [
        "phase",
        "requested_effect",
        "granted_effects",
        "reason"
      ],
      "additionalProperties": false
    },
    "prerequisite": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "required": {
          "type": "boolean"
        },
        "detail": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "required",
        "detail"
      ],
      "additionalProperties": false
    },
    "plan_signature": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "string",
          "const": "guild-execution-plan-signature-v1"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "ed25519"
          ]
        },
        "publisher_id": {
          "type": "string",
          "minLength": 1
        },
        "signed_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "signature_base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format_version",
        "scheme",
        "publisher_id",
        "signed_digest",
        "signature_base64"
      ],
      "additionalProperties": false
    }
  }
}
