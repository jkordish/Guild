{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild Delegated Capability Token",
  "type": "object",
  "properties": {
    "kind": {
      "const": "guild.delegated_capability_token"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "token_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "key_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "issuer_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "issuer_id",
        "key_id",
        "issuer_epoch"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "not_before": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "execution_plan_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "execution_plan_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "proof_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_status": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/proof_status"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_source_kind": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/proof_source_kind"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_exact_bindings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/host_exact_binding"
      }
    },
    "issuance_basis": {
      "$ref": "common.schema.json#/$defs/token_issuance_basis"
    },
    "skill_contract_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "contract_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "component_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "export_name": {
      "type": "string",
      "minLength": 1
    },
    "input_class_fingerprint": {
      "$ref": "common.schema.json#/$defs/input_class_fingerprint"
    },
    "chosen_runtime": {
      "type": "object",
      "properties": {
        "runtime_guarantee_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "runtime_guarantee_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "vendor": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runtime_guarantee_id",
        "runtime_guarantee_digest",
        "runtime"
      ],
      "additionalProperties": false
    },
    "audience_binding": {
      "type": "object",
      "properties": {
        "audiences": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resource_binding"
          }
        }
      },
      "required": [
        "audiences",
        "resources"
      ],
      "additionalProperties": false
    },
    "holder_binding": {
      "type": "object",
      "properties": {
        "holder_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "issued_for_delegatee": {
          "type": "boolean"
        }
      },
      "required": [
        "holder_id",
        "issued_for_delegatee"
      ],
      "additionalProperties": false
    },
    "granted_authority": {
      "$ref": "common.schema.json#/$defs/authority_plan"
    },
    "parent_token": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "token_id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "token_digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          },
          "required": [
            "token_id",
            "token_digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "call_chain": {
      "type": "object",
      "properties": {
        "chain_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "chain_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "chain_id",
        "links",
        "chain_digest"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "common.schema.json#/$defs/token_delegation_mode"
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "remaining_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "mode",
        "max_hops",
        "remaining_hops"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "max_hops": {
                "const": 0
              },
              "remaining_hops": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "one_hop"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "max_hops": {
                "const": 1
              },
              "remaining_hops": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "bounded_hops"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "max_hops": {
                "minimum": 2
              },
              "remaining_hops": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "passthrough_policy": {
      "$ref": "common.schema.json#/$defs/issued_token_passthrough_mode"
    },
    "replay_protection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "common.schema.json#/$defs/token_replay_mode"
        },
        "replay_cache_key": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "replay_cache_key"
      ],
      "additionalProperties": false
    },
    "revocation_hooks": {
      "type": "object",
      "properties": {
        "issuer_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "issuer_epoch"
      ],
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "common.schema.json#/$defs/token_protection_mode"
        },
        "canonicalization": {
          "type": "string",
          "const": "guild-json-c14n-v1"
        },
        "claims_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "mac_base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "canonicalization",
        "claims_digest",
        "mac_base64"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "version",
    "token_id",
    "issuer",
    "issued_at",
    "not_before",
    "expires_at",
    "request_id",
    "execution_plan_id",
    "execution_plan_digest",
    "proof_id",
    "proof_status",
    "issuance_basis",
    "skill_contract_id",
    "contract_digest",
    "component_digest",
    "export_name",
    "input_class_fingerprint",
    "chosen_runtime",
    "audience_binding",
    "holder_binding",
    "granted_authority",
    "parent_token",
    "call_chain",
    "delegation",
    "passthrough_policy",
    "replay_protection",
    "revocation_hooks",
    "protection"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "issuance_basis": {
            "const": "m5_proven_subset"
          }
        },
        "required": [
          "issuance_basis"
        ]
      },
      "then": {
        "properties": {
          "proof_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "proof_status": {
            "$ref": "common.schema.json#/$defs/proof_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "issuance_basis": {
            "const": "m4_upper_bound"
          }
        },
        "required": [
          "issuance_basis"
        ]
      },
      "then": {
        "properties": {
          "proof_id": {
            "type": "null"
          },
          "proof_status": {
            "type": "null"
          }
        }
      }
    }
  ]
}
