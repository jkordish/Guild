{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild Common Definitions",
  "type": "object",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@+-]+$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "blake3"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "witness_level": {
      "type": "string",
      "enum": [
        "summary",
        "decision",
        "hostcall",
        "full"
      ]
    },
    "admission_decision": {
      "type": "string",
      "enum": [
        "admit",
        "downgrade",
        "migrate",
        "refuse"
      ]
    },
    "admission_reason_code": {
      "type": "string",
      "enum": [
        "CONTRACT_REFERENCE_MISMATCH",
        "EXPORT_OVERRIDE_INVALID",
        "INPUT_CLASS_MISMATCH",
        "NO_ADMISSIBLE_RUNTIME",
        "NO_CANDIDATE_RUNTIME",
        "PLAN_SIGNING_UNAVAILABLE",
        "PREFERRED_RUNTIME_NOT_ADMISSIBLE",
        "REQUIRED_EFFECT_UNSUPPORTED",
        "REQUIRED_SCOPE_NOT_ENFORCEABLE",
        "REQUESTED_AUTHORITY_EXCEEDS_CONTRACT_CEILING",
        "REQUESTED_AUTHORITY_FORBIDDEN_BY_CONTRACT",
        "REQUESTED_AUTHORITY_OMITS_REQUIRED_EFFECT",
        "REQUESTED_SCOPE_NOT_ENFORCEABLE",
        "REQUESTED_SCOPE_REDUCED_FOR_CONTRACT",
        "REQUESTED_WITNESS_LEVEL_UNAVAILABLE",
        "RUNTIME_ANTI_REPLAY_UNSUPPORTED",
        "RUNTIME_AUDIENCE_BINDING_UNSUPPORTED",
        "RUNTIME_AUTHORITY_PLAN_DIGEST_UNSUPPORTED",
        "RUNTIME_CALL_CHAIN_BINDING_UNSUPPORTED",
        "RUNTIME_CANDIDATE_UNKNOWN",
        "RUNTIME_CHILD_PROCESS_MODE_UNSUPPORTED",
        "RUNTIME_COMPONENT_MODEL_UNSUPPORTED",
        "RUNTIME_COMPONENT_MODEL_VERSION_UNSUPPORTED",
        "RUNTIME_EXECUTION_ISOLATION_TOO_WEAK",
        "RUNTIME_FILESYSTEM_ISOLATION_TOO_WEAK",
        "RUNTIME_GUARANTEE_INVALID",
        "RUNTIME_MAX_HOPS_ENFORCEMENT_UNSUPPORTED",
        "RUNTIME_NETWORK_GRANULARITY_TOO_WEAK",
        "RUNTIME_REDACTED_IO_HASHES_UNSUPPORTED",
        "RUNTIME_REVOCATION_MODE_UNSUPPORTED",
        "RUNTIME_SIGNATURE_MODE_UNSUPPORTED",
        "RUNTIME_TAMPER_EVIDENCE_MODE_UNSUPPORTED",
        "RUNTIME_TOKEN_PASSTHROUGH_MODE_UNSUPPORTED",
        "RUNTIME_TRUSTED_TIME_SOURCE_UNSUPPORTED",
        "RUNTIME_WITNESS_LEVEL_UNSUPPORTED",
        "RUNTIME_WIT_WORLD_UNDECLARED",
        "RUNTIME_WIT_WORLD_UNSUPPORTED"
      ]
    },
    "minimization_reason_code": {
      "type": "string",
      "enum": [
        "AUTHORITY_REQUIRED_BY_COMPARATOR",
        "AUTHORITY_REQUIRED_BY_TRACE",
        "COMPARATOR_FAILED",
        "COMPARATOR_NONDETERMINISTIC",
        "COMPARATOR_PROFILE_INVALID",
        "COMPARATOR_UNAVAILABLE",
        "LIVE_COMPARATOR_NONDETERMINISTIC",
        "LIVE_COMPARATOR_UNAVAILABLE",
        "LIVE_PROOF_BOUNDED",
        "LIVE_PROOF_PREREQUISITE_FAILED",
        "LIVE_PROOF_SUPPORTED",
        "LIVE_PROOF_UNSUPPORTED",
        "LIVE_REPLAY_UNAVAILABLE",
        "HTTP_COMPARATOR_UNSUPPORTED_FOR_LIVE_PROOF",
        "HTTP_HOST_UNSUPPORTED_FOR_LIVE_PROOF",
        "HTTP_HOST_RESOLUTION_BINDING_UNAVAILABLE",
        "HTTP_HOST_RESOLUTION_BINDING_UNSAFE",
        "HTTP_LIVE_PROOF_BOUNDED",
        "HTTP_MULTI_REQUEST_UNSUPPORTED",
        "HTTP_QUERY_UNSUPPORTED",
        "HTTP_REDIRECTS_UNSUPPORTED",
        "HTTP_REPLAY_FIXTURE_REQUIRED",
        "HTTP_REQUEST_SHAPE_UNSUPPORTED",
        "HTTP_SCHEME_UNSUPPORTED_FOR_LIVE_PROOF",
        "EMIT_EVIDENCE_COMPARATOR_UNAVAILABLE",
        "EMIT_EVIDENCE_LINKAGE_MODEL_UNAVAILABLE",
        "EMIT_EVIDENCE_MULTI_EMIT_UNSUPPORTED",
        "EMIT_EVIDENCE_PAYLOAD_NONDETERMINISTIC",
        "EMIT_EVIDENCE_REPLAY_UNAVAILABLE",
        "EMIT_EVIDENCE_RESULT_ERROR_UNSUPPORTED",
        "EMIT_EVIDENCE_SINK_MODEL_UNAVAILABLE",
        "INVOKE_SKILL_CHILD_AUTHORITY_UNSUPPORTED",
        "INVOKE_SKILL_CHILD_IDENTITY_UNBOUND",
        "INVOKE_SKILL_COMPARATOR_UNAVAILABLE",
        "INVOKE_SKILL_DYNAMIC_RESOLUTION_UNSUPPORTED",
        "INVOKE_SKILL_EXPORT_WORLD_UNSUPPORTED",
        "INVOKE_SKILL_LIVE_PROOF_BOUNDED",
        "INVOKE_SKILL_MULTI_CHILD_UNSUPPORTED",
        "INVOKE_SKILL_RECURSION_UNSUPPORTED",
        "INVOKE_SKILL_REPLAY_UNAVAILABLE",
        "LIVE_SCOPE_SHRINK_UNSUPPORTED",
        "PLAN_NOT_ADMISSIBLE",
        "PLAN_RUNTIME_MISMATCH",
        "PROOF_LINKAGE_UNAVAILABLE",
        "PROOF_CACHE_BYPASSED",
        "PROOF_CACHE_HIT",
        "PROOF_CACHE_MISS",
        "RUNTIME_CANNOT_ENFORCE_SHRUNK_SCOPE",
        "SCOPE_SHRINK_UNSUPPORTED",
        "SEARCH_BUDGET_EXCEEDED",
        "SEARCH_MODEL_UNSUPPORTED",
        "SHADOW_EXECUTION_FAILED",
        "SHADOW_HARNESS_UNAVAILABLE",
        "TOKEN_PROOF_BASIS_DRAFT",
        "TOKEN_PROOF_BASIS_LIVE"
      ]
    },
    "proof_status": {
      "type": "string",
      "enum": [
        "exact_minimal",
        "bounded_minimal",
        "reduced",
        "no_reduction",
        "not_proven"
      ]
    },
    "proof_cache_status": {
      "type": "string",
      "enum": [
        "miss",
        "hit",
        "bypassed"
      ]
    },
    "token_issuance_basis": {
      "type": "string",
      "enum": [
        "m5_proven_subset",
        "m4_upper_bound"
      ]
    },
    "token_delegation_mode": {
      "type": "string",
      "enum": [
        "none",
        "one_hop",
        "bounded_hops"
      ]
    },
    "token_protection_mode": {
      "type": "string",
      "enum": [
        "hmac-sha256"
      ]
    },
    "token_replay_mode": {
      "type": "string",
      "enum": [
        "none",
        "single_use"
      ]
    },
    "issued_token_passthrough_mode": {
      "type": "string",
      "enum": [
        "forbidden",
        "same_invocation_only",
        "one_hop_bound"
      ]
    },
    "token_issuance_reason_code": {
      "type": "string",
      "enum": [
        "CRYPTO_PRIMITIVE_UNAVAILABLE",
        "DELEGATION_HOPS_EXHAUSTED",
        "DELEGATION_NOT_ALLOWED",
        "PARENT_CHILD_AUDIENCE_BROADENING",
        "PARENT_CHILD_CALL_CHAIN_MISMATCH",
        "PARENT_CHILD_DELEGATION_BROADENING",
        "PARENT_CHILD_RUNTIME_BROADENING",
        "PARENT_CHILD_SCOPE_BROADENING",
        "PARENT_CHILD_TTL_BROADENING",
        "PARENT_TOKEN_INVALID",
        "PARENT_TOKEN_REQUIRED",
        "PLAN_CONTRACT_MISMATCH",
        "PLAN_NOT_ADMISSIBLE",
        "PLAN_RUNTIME_MISMATCH",
        "PROOF_NOT_ACCEPTABLE",
        "PROOF_PLAN_MISMATCH",
        "PROOF_RUNTIME_MISMATCH",
        "REPLAY_STATE_UNAVAILABLE",
        "TOKEN_AUDIENCE_BINDING_REQUIRED",
        "TOKEN_CALL_CHAIN_BINDING_REQUIRED",
        "TOKEN_EXPIRY_EXCEEDS_PLAN",
        "TOKEN_EXPIRY_EXCEEDS_PROOF",
        "TOKEN_HOLDER_BINDING_REQUIRED",
        "TOKEN_PASSTHROUGH_FORBIDDEN",
        "TOKEN_RUNTIME_BINDING_REQUIRED",
        "TOKEN_SCOPE_EXCEEDS_PLAN",
        "TOKEN_SCOPE_EXCEEDS_PROOF",
        "UPPER_BOUND_ISSUANCE_DISALLOWED"
      ]
    },
    "token_verification_reason_code": {
      "type": "string",
      "enum": [
        "AUDIENCE_MISMATCH",
        "CALL_CHAIN_MISMATCH",
        "CRYPTO_PRIMITIVE_UNAVAILABLE",
        "CRYPTO_PROTECTION_INVALID",
        "DELEGATION_HOPS_EXHAUSTED",
        "HOLDER_BINDING_MISMATCH",
        "ISSUER_UNKNOWN",
        "KEY_ID_UNKNOWN",
        "PARENT_CHILD_AUDIENCE_BROADENING",
        "PARENT_CHILD_DELEGATION_BROADENING",
        "PARENT_CHILD_RUNTIME_BROADENING",
        "PARENT_CHILD_SCOPE_BROADENING",
        "PARENT_CHILD_TTL_BROADENING",
        "PARENT_TOKEN_INVALID",
        "PARENT_TOKEN_REQUIRED",
        "PLAN_CONTRACT_MISMATCH",
        "PLAN_NOT_ADMISSIBLE",
        "PLAN_RUNTIME_MISMATCH",
        "PROOF_NOT_ACCEPTABLE",
        "PROOF_PLAN_MISMATCH",
        "PROOF_RUNTIME_MISMATCH",
        "REPLAY_STATE_UNAVAILABLE",
        "RESOURCE_BINDING_MISMATCH",
        "RUNTIME_BINDING_MISMATCH",
        "TOKEN_EXPIRED",
        "TOKEN_NOT_YET_VALID",
        "TOKEN_PASSTHROUGH_FORBIDDEN",
        "TOKEN_REPLAYED",
        "TOKEN_REVOKED",
        "TOKEN_SCHEMA_INVALID",
        "TOKEN_SCOPE_EXCEEDS_PLAN",
        "TOKEN_SCOPE_EXCEEDS_PROOF"
      ]
    },
    "witness_coverage_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "insufficient"
      ]
    },
    "witness_status": {
      "type": "string",
      "enum": [
        "within_envelope",
        "out_of_envelope",
        "coverage_limited",
        "unverifiable"
      ]
    },
    "witness_mapping_status": {
      "type": "string",
      "enum": [
        "exact",
        "narrowing",
        "partial",
        "unsupported"
      ]
    },
    "witness_derivation_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "not_derivable"
      ]
    },
    "witness_reason_code": {
      "type": "string",
      "enum": [
        "AUDIENCE_BINDING_MISMATCH",
        "CANONICAL_FAMILY_PARTIAL",
        "CANONICAL_FAMILY_SUPPORTED",
        "CANONICAL_FAMILY_UNSUPPORTED",
        "CALL_CHAIN_MISMATCH",
        "CLAIM_NOT_PROVABLE_FROM_COVERAGE",
        "CLAIM_UNSUPPORTED",
        "COMPAT_ALIAS_DEPRECATED",
        "COMPAT_ALIAS_USED",
        "DIRECT_FAMILY_REQUIRED",
        "HOLDER_BINDING_MISMATCH",
        "LIVE_MINIMIZATION_UNAVAILABLE",
        "OBSERVATION_COVERAGE_INSUFFICIENT",
        "OBSERVATION_COVERAGE_PARTIAL",
        "OBSERVATION_SOURCE_UNAVAILABLE",
        "OBSERVATION_SOURCE_UNSUPPORTED",
        "OBSERVED_EFFECT_OUTSIDE_PLAN",
        "OBSERVED_EFFECT_OUTSIDE_PROOF",
        "OBSERVED_EFFECT_OUTSIDE_TOKEN",
        "NEGATIVE_CLAIM_UNSUPPORTED_FOR_FAMILY",
        "PLAN_LINKAGE_MISMATCH",
        "PROOF_LINKAGE_UNAVAILABLE",
        "PROOF_LINKAGE_MISMATCH",
        "LIVE_RUNTIME_ALIGNMENT_INCOMPLETE",
        "LIVE_WITNESS_COVERAGE_PARTIAL",
        "RUNTIME_OBSERVATION_UNMAPPABLE",
        "REDACTION_PREVENTS_CLAIM_VERIFICATION",
        "REDACTION_HASH_MISMATCH",
        "RUNTIME_BINDING_MISMATCH",
        "TOKEN_LINKAGE_MISMATCH",
        "TOKEN_VERIFICATION_FAILED",
        "TRACE_PARSE_FAILED",
        "VOCABULARY_MAPPING_NARROWING",
        "VOCABULARY_MAPPING_PARTIAL",
        "VOCABULARY_MAPPING_UNSUPPORTED",
        "WITNESS_ISSUER_UNKNOWN",
        "WITNESS_KEY_ID_UNKNOWN",
        "WITNESS_MAC_INVALID",
        "WITNESS_PROOF_LINKAGE_UNAVAILABLE",
        "WITNESS_REASON_CODES_INCONSISTENT",
        "WITNESS_SCHEMA_INVALID",
        "WITNESS_STATUS_INCONSISTENT"
      ]
    },
    "witness_claim_type": {
      "type": "string",
      "enum": [
        "no_authority_use_outside_plan",
        "no_authority_use_outside_proof",
        "no_authority_use_outside_token",
        "no_http_request_outside_scope",
        "no_read_resource_outside_scope",
        "no_invoke_skill_outside_scope",
        "no_emit_evidence_outside_scope",
        "no_log_write_outside_scope",
        "no_filesystem_writes_outside_prefixes",
        "no_network_egress_except_allowlist",
        "no_delegation_beyond_hops",
        "no_blocked_attempts_of_classes",
        "no_blocked_attempts_of_families"
      ]
    },
    "witness_claim_status": {
      "type": "string",
      "enum": [
        "satisfied",
        "violated",
        "not_provable",
        "unsupported"
      ]
    },
    "witness_claim": {
      "type": "object",
      "properties": {
        "claim_type": {
          "$ref": "#/$defs/witness_claim_type"
        },
        "effect_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect_class"
          },
          "uniqueItems": true
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonical_effect_family"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "network_allowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/network_audience"
          }
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "http_request_scope": {
          "$ref": "#/$defs/http_request_scope"
        },
        "read_resource_scope": {
          "$ref": "#/$defs/read_resource_scope"
        },
        "invoke_skill_scope": {
          "$ref": "#/$defs/invoke_skill_scope"
        },
        "emit_evidence_scope": {
          "$ref": "#/$defs/emit_evidence_scope"
        },
        "log_write_scope": {
          "$ref": "#/$defs/log_write_scope"
        }
      },
      "required": [
        "claim_type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_http_request_outside_scope"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "http_request_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_read_resource_outside_scope"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "read_resource_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_invoke_skill_outside_scope"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "invoke_skill_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_emit_evidence_outside_scope"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "emit_evidence_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_log_write_outside_scope"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "log_write_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_filesystem_writes_outside_prefixes"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "paths"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_network_egress_except_allowlist"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "network_allowlist"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_delegation_beyond_hops"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "max_hops"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_blocked_attempts_of_families"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "families"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "no_blocked_attempts_of_classes"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "required": [
              "effect_classes"
            ]
          }
        }
      ]
    },
    "trial_result": {
      "type": "string",
      "enum": [
        "equivalent",
        "non_equivalent",
        "error",
        "timeout",
        "not_proven"
      ]
    },
    "execution_isolation_assurance": {
      "type": "string",
      "enum": [
        "none",
        "best_effort",
        "strong"
      ]
    },
    "filesystem_isolation_class": {
      "type": "string",
      "enum": [
        "none",
        "path_filter",
        "preopen_only",
        "virtual_fs",
        "os_sandbox"
      ]
    },
    "network_policy_granularity": {
      "type": "string",
      "enum": [
        "none",
        "binary",
        "domain",
        "host_port",
        "url"
      ]
    },
    "child_process_mode": {
      "type": "string",
      "enum": [
        "forbidden",
        "brokered",
        "unrestricted"
      ]
    },
    "token_passthrough_mode": {
      "type": "string",
      "enum": [
        "forbidden",
        "same_invocation_only",
        "one_hop_bound",
        "unrestricted"
      ]
    },
    "revocation_mode": {
      "type": "string",
      "enum": [
        "expiry_only",
        "best_effort_live",
        "lease",
        "hard_kill_live"
      ]
    },
    "tamper_evidence_mode": {
      "type": "string",
      "enum": [
        "none",
        "hash_chain",
        "merkle_chain"
      ]
    },
    "signature_mode": {
      "type": "string",
      "enum": [
        "none",
        "runtime_key",
        "external_signer"
      ]
    },
    "observation_source_kind": {
      "type": "string",
      "enum": [
        "draft-example-harness",
        "bounded-observation-fixture",
        "live-runtime-hook"
      ]
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "none",
        "summary_only",
        "counts_only"
      ]
    },
    "effect_class": {
      "type": "string",
      "enum": [
        "fs.read",
        "fs.write",
        "fs.list",
        "net.connect",
        "net.resolve",
        "proc.spawn",
        "proc.signal",
        "secret.read",
        "env.read",
        "clock.read",
        "random.read",
        "component.invoke",
        "capability.delegate"
      ]
    },
    "canonical_effect_family": {
      "type": "string",
      "enum": [
        "http-request",
        "read-resource",
        "invoke-skill",
        "emit-evidence",
        "log-write",
        "filesystem",
        "get-secret",
        "cache-read",
        "cache-write",
        "monotonic-clock",
        "wall-clock"
      ]
    },
    "canonical_scope_kind": {
      "type": "string",
      "enum": [
        "network",
        "resource",
        "skill",
        "evidence",
        "log",
        "filesystem",
        "secret",
        "cache",
        "clock"
      ]
    },
    "glob_or_path": {
      "type": "string",
      "minLength": 1
    },
    "hostname_pattern": {
      "type": "string",
      "minLength": 1
    },
    "http_method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
