    "delegation_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "forbidden",
            "same_invocation_only",
            "bounded_hops"
          ]
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "allowed_effect_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect_class"
          }
        },
        "allowed_authority_selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authority_selector"
          },
          "uniqueItems": true
        },
        "audience_binding_required": {
          "type": "boolean"
        },
        "call_chain_binding_required": {
          "type": "boolean"
        },
        "anti_replay_required": {
          "type": "boolean"
        },
        "ttl_seconds_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "mode",
        "audience_binding_required",
        "call_chain_binding_required",
        "anti_replay_required",
        "ttl_seconds_max"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "forbidden"
              }
            }
          },
          "then": {
            "properties": {
              "max_hops": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "same_invocation_only"
              }
            }
          },
          "then": {
            "properties": {
              "max_hops": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "bounded_hops"
              }
            }
          },
          "then": {
            "required": [
              "max_hops"
            ],
            "anyOf": [
              {
                "required": [
                  "allowed_effect_classes"
                ]
              },
              {
                "required": [
                  "allowed_authority_selectors"
                ]
              }
            ],
            "properties": {
              "max_hops": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
