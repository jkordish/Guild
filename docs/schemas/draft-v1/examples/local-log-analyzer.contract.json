    {
      "effect_class": "net.connect",
      "scope": {
        "kind": "network",
        "audiences": [
          {
            "host": "*",
            "ports": [
              "*"
            ],
            "schemes": [
              "*"
            ],
            "path_prefixes": [
              "/"
            ],
            "methods": [
              "*"
            ]
          }
        ]
      },
      "justification": "No egress permitted"
    },
    {
      "effect_class": "proc.spawn",
      "scope": {
        "kind": "process",
        "commands": [
          "*"
        ]
      },
      "justification": "No child process execution"
    },
    {
      "effect_class": "capability.delegate",
      "scope": {
        "kind": "delegation"
      },
      "justification": "No capability forwarding"
    }
  ],
  "authority_ceiling": [
    {
      "effect_class": "fs.read",
      "scope": {
        "kind": "filesystem",
        "paths": [
          "/workspace/input/**"
        ],
        "symlink_policy": "deny",
        "follow_mounts": false
