{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild Admission Request",
  "type": "object",
  "properties": {
    "kind": {
      "const": "guild.admission_request"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "contract": {
      "oneOf": [
        {
          "$ref": "skill_contract.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "contract_id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "component_digest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "source_uri": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "contract_id",
            "component_digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "export_name_override": {
      "type": "string",
      "minLength": 1
    },
    "input_class_fingerprint": {
      "$ref": "common.schema.json#/$defs/input_class_fingerprint"
    },
    "runtime_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "runtime_guarantee.schema.json"
          },
          {
            "type": "object",
            "properties": {
              "runtime_guarantee_id": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "source_uri": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "runtime_guarantee_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "preferred_runtime_guarantee_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "requested_authority": {
      "type": "object",
      "properties": {
        "grants": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "common.schema.json#/$defs/effect_spec"
          },
          "default": []
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "grants"
      ],
      "additionalProperties": false
    },
    "requested_witness_level": {
      "$ref": "common.schema.json#/$defs/witness_level"
    },
    "audience_binding_inputs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "resource_binding_inputs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "effect_class": {
            "$ref": "common.schema.json#/$defs/effect_class"
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "effect_class",
          "resource",
          "audience"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "delegation_chain_input": {
      "type": "object",
      "properties": {
        "caller_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "requested_max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "caller_chain",
        "requested_max_hops"
      ],
      "additionalProperties": false
    },
    "invocation_constraints": {
      "type": "object",
      "properties": {
        "valid_for_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "not_before": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "not_after": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "kind",
    "version",
    "request_id",
    "contract",
    "input_class_fingerprint",
    "runtime_candidates",
    "requested_authority"
  ],
  "additionalProperties": false
}
